"""Peak spectral power (PSP), PHOEBE style (Pollonini et al. 2016, Biomed Opt Express 7:5104).

Same windowing as SCI: band-pass to the cardiac band, cut into windows. In
each window, cross-correlate the two (std-normalized) signals and take the
peak of a Hamming periodogram of that cross-correlation. A channel's PSP = median across windows.

Scaling: the periodogram is computed as a power spectral DENSITY
(scaling='density', the default of scipy's periodogram and of MATLAB's), which
is what the reference implementation in MNE-NIRS (mne_nirs.preprocessing.
peak_power) uses, and is the scale its 0.1 threshold refers to. With this
scaling and the default 5 s windows, a clean channel lands around 1.0-1.4 in
synthetic tests and a channel with a barely visible pulse falls to roughly
0.2 or below. The score grows with window length, so keep WINDOW_S fixed when
comparing against the 0.1 threshold.

"""
import numpy as np
from scipy.signal import periodogram

from fnirs_PFC_2025.preprocessing.sci import CARDIAC_BAND, WINDOW_S, cardiac_windows

_SCALINGS = ('density', 'spectrum')


def peak_spectral_power(od1, od2, fs, band=CARDIAC_BAND, window_s=WINDOW_S, scaling='density'):
    if scaling not in _SCALINGS:
        raise ValueError(f"scaling must be one of {_SCALINGS}, got {scaling!r}")
    windows = cardiac_windows(od1, od2, fs, band, window_s)
    if not windows:
        return float('nan')
    scores = []
    for n1, n2 in windows:
        xc = np.correlate(n1, n2, mode='full') / len(n1)
        _, power = periodogram(xc, fs=fs, window='hamming', nfft=len(xc), scaling=scaling)
        scores.append(power.max())
    return float(np.median(scores))
